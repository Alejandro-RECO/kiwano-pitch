---
import Slide from '../Slide.astro';
import Icon from '../Icon.astro';

const capabilities = [
  {
    icon: 'scan-search',
    title: 'Reconocimiento de patrones',
    text: 'Aprende de los datos históricos.',
  },
  {
    icon: 'sliders',
    title: 'Reglas de negocio',
    text: 'Decide con los criterios de cada empresa.',
  },
  {
    icon: 'bot',
    title: 'Agentes entrenables',
    text: 'Mejora con cada caso nuevo.',
  },
] as const;

const uses = [
  { title: 'Documentos', text: 'guías y facturas sin digitar' },
  { title: 'Envíos', text: 'rutas recomendadas' },
  { title: 'Excepciones', text: 'detecta retrasos y escala' },
  { title: 'Clientes', text: '“¿dónde está mi pedido?”' },
  { title: 'Conciliación', text: 'facturado contra entregado' },
] as const;
---

<Slide id="kiwano">
  <div class="split">
    <div>
      <h2 class="slide__title">La solución: Kiwano</h2>
      <p class="slide__lead">
        Agentes de IA que asumen los procesos repetitivos de una pyme, con sus reglas y <strong class="hot">24/7</strong>.
      </p>

      <ul class="slide__body caps">
        {
          capabilities.map((c) => (
            <li class="cap">
              <span class="disc">
                <Icon name={c.icon} />
              </span>
              <div>
                <h3>{c.title}</h3>
                <p>{c.text}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>

    <aside class="engine" aria-labelledby="engine-title">
      <p class="engine__claim" id="engine-title">En logística, el agente asume:</p>
      <ul class="engine__traits">
        {
          uses.map((u) => (
            <li>
              <span>
                <strong>{u.title}:</strong> {u.text}
              </span>
            </li>
          ))
        }
      </ul>
    </aside>
  </div>
</Slide>

<style>
  .split {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(280px, 0.9fr);
    gap: clamp(1.5rem, 4vw, 4rem);
    align-items: center;
  }

  .hot {
    color: var(--kiwi);
    font-weight: 700;
    
  }

  .caps {
    display: grid;
    gap: 1.25rem;
  }

  .cap {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
  }

  .cap h3 {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--step-2);
    line-height: 1.15;
    color: var(--title);
  }

  .cap p {
    margin-top: 0.25rem;
    color: var(--muted);
    max-width: 48ch;
    text-wrap: pretty;
  }

  .engine {
    background: var(--deep);
    color: var(--cream);
    border-radius: var(--radius-l);
    padding: clamp(1.5rem, 3vw, 2.5rem);
    display: grid;
    gap: 1rem;
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--kiwi) 30%, transparent);
  }

  .engine__claim {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--step-3);
    line-height: 1.1;
    text-wrap: balance;
  }

  .engine__now {
    font-size: var(--step--1);
    color: color-mix(in srgb, var(--cream) 80%, var(--deep));
    text-wrap: pretty;
  }

  .engine__traits {
    display: grid;
    gap: 0.55rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid color-mix(in srgb, var(--cream) 25%, transparent);
  }

  .engine__traits strong {
    color: var(--kiwi);
  }

  .engine__traits li {
    display: flex;
    gap: 0.6rem;
    align-items: baseline;
  }

  .engine__traits li::before {
    content: '';
    flex: none;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--kiwi);
    transform: translateY(-1px);
  }

  @media (max-width: 900px) {
    .split {
      grid-template-columns: 1fr;
    }
  }
</style>
