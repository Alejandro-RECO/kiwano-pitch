---
import Slide from '../Slide.astro';

const phases = [
  {
    id: 'fase-diagnostico',
    title: 'Diagnóstico',
    text: 'Elegir el proceso con más retorno.',
  },
  {
    title: 'Diseño del agente',
    text: 'Reglas y puntos de control.',
  },
  {
    title: 'Entrenamiento',
    text: 'Datos históricos del cliente.',
  },
  {
    title: 'Piloto',
    text: 'Un proceso, resultados medibles.',
  },
  {
    title: 'Despliegue',
    text: 'Escalar y mejorar con cada caso.',
  },
];
---

<Slide id="implementacion">
  <h2 class="slide__title">¿Cómo se implementa?</h2>
  <p class="slide__lead">Cinco fases, con supervisión humana.</p>

  <ol class="slide__body phases">
    {
      phases.map((p, i) => (
        <li class="phase" id={p.id}>
          <span class="phase__num" aria-hidden="true">
            {i + 1}
          </span>
          <h3>
            <span class="visually-hidden">Fase {i + 1}: </span>
            {p.title}
          </h3>
          <p>{p.text}</p>
        </li>
      ))
    }
  </ol>

</Slide>

<style>
  .phases {
    position: relative;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: clamp(0.75rem, 2vw, 1.5rem);
    counter-reset: phase;
  }

  /* Línea de proceso: pasa por el centro de los nodos. */
  .phases::before {
    content: '';
    position: absolute;
    top: 1.5rem;
    left: 10%;
    right: 10%;
    height: 2px;
    background: linear-gradient(90deg, var(--kiwi), var(--deep) 30%, var(--deep));
  }

  .phase {
    position: relative;
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 0.5rem;
    align-content: start;
  }

  .phase__num {
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--deep);
    color: var(--cream);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--step-2);
    box-shadow: 0 0 0 6px var(--bg);
  }

  .phase:first-child .phase__num {
    box-shadow:
      0 0 0 6px var(--bg),
      0 0 0 8px var(--kiwi),
      var(--glow);
  }

  .phase h3 {
    margin-top: 0.5rem;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--step-2);
    line-height: 1.1;
    color: var(--title);
    text-wrap: balance;
  }

  .phase p {
    font-size: var(--step--1);
    color: var(--muted);
    max-width: 24ch;
    text-wrap: pretty;
  }


  @media (max-width: 900px) {
    .phases {
      grid-template-columns: 1fr;
      gap: 1.25rem;
      padding-left: 0.25rem;
    }

    .phases::before {
      top: 1rem;
      bottom: 1rem;
      left: 1.5rem;
      right: auto;
      width: 2px;
      height: auto;
      background: linear-gradient(180deg, var(--kiwi), var(--deep) 30%, var(--deep));
    }

    .phase {
      grid-template-columns: 3rem 1fr;
      grid-template-areas:
        'num title'
        'num text';
      justify-items: start;
      text-align: left;
      column-gap: 1rem;
      row-gap: 0.25rem;
    }

    .phase__num {
      grid-area: num;
      transform: translateX(-0.25rem);
    }

    .phase h3 {
      grid-area: title;
      margin-top: 0.6rem;
    }

    .phase p {
      grid-area: text;
      max-width: none;
    }
  }
</style>
