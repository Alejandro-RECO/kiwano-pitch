---
import Slide from '../Slide.astro';
import Icon from '../Icon.astro';

const facets = [
  { icon: 'building', title: 'Sin equipo técnico' },
  { icon: 'gauge', title: 'Decide por retorno' },
  { icon: 'shield-check', title: 'Busca control' },
  { icon: 'bot', title: 'Cauteloso con la IA' },
] as const;

// Buyer persona que resume al cliente objetivo.
const persona = {
  nombre: 'Andrés Gómez',
  cargo: '38 años · Gerente de una distribuidora en Fontibón',
  datos: [
    { cifra: '25', texto: 'empleados' },
    { cifra: '1.800', texto: 'pedidos al mes' },
    { cifra: '3', texto: 'auxiliares digitando' },
  ],
  frase: '«Necesito que la operación funcione igual, esté yo o no.»',
};
---

<Slide id="cliente">
  <h2 class="slide__title">¿A quién le hablamos?</h2>
  <p class="slide__lead">Gerentes de PyMes logísticas en Bogotá.</p>

  <div class="slide__body layout">
    <figure class="card">
      <svg class="avatar" viewBox="0 0 120 120" aria-hidden="true">
        <circle cx="60" cy="60" r="58" class="avatar__bg" />
        <path d="M18 112c4-24 22-36 42-36s38 12 42 36" class="avatar__body" />
        <path d="M60 76l-8 14 8 22 8-22z" class="avatar__tie" />
        <circle cx="60" cy="46" r="22" class="avatar__head" />
        <path d="M38 42c0-14 10-22 22-22s22 8 22 22c-6-6-14-8-22-8s-16 2-22 8z" class="avatar__hair" />
        <g class="avatar__glasses">
          <rect x="44" y="44" width="13" height="9" rx="3" />
          <rect x="63" y="44" width="13" height="9" rx="3" />
          <line x1="57" y1="48" x2="63" y2="48" />
        </g>
      </svg>
      <figcaption>
        <p class="card__name">{persona.nombre}</p>
        <p class="card__role">{persona.cargo}</p>
      </figcaption>
      <ul class="card__stats">
        {
          persona.datos.map((d) => (
            <li>
              <b>{d.cifra}</b>
              <span>{d.texto}</span>
            </li>
          ))
        }
      </ul>
      <blockquote>{persona.frase}</blockquote>
    </figure>

    <ul class="facets">
      {
        facets.map((f) => (
          <li class="facet">
            <span class="disc">
              <Icon name={f.icon} />
            </span>
            <h3>{f.title}</h3>
          </li>
        ))
      }
    </ul>
  </div>

  <p class="takeaway">
    Le vendemos un MVP de bajo riesgo, no innovación.
  </p>
</Slide>

<style>
  .layout {
    display: grid;
    grid-template-columns: minmax(260px, 0.8fr) minmax(0, 2fr);
    gap: clamp(1.5rem, 4vw, 3.5rem);
    align-items: center;
  }
  .card {
    position: relative;
    background: var(--deep);
    color: var(--cream);
    border-radius: var(--radius-l);
    padding: clamp(1.25rem, 2.5vw, 1.75rem);
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 0.75rem;
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--kiwi) 30%, transparent);
  }
  .avatar {
    width: clamp(84px, 9vw, 112px);
    height: auto;
  }
  .avatar__bg {
    fill: color-mix(in srgb, var(--kiwi) 30%, var(--deep));
  }
  .avatar__body {
    fill: var(--brown);
  }
  .avatar__tie {
    fill: var(--kiwi);
  }
  .avatar__head {
    fill: color-mix(in srgb, var(--brown) 45%, var(--cream));
  }
  .avatar__hair {
    fill: var(--ink);
  }
  .avatar__glasses rect,
  .avatar__glasses line {
    fill: none;
    stroke: var(--ink);
    stroke-width: 2;
  }
  .card__name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--step-3);
    line-height: 1.1;
  }
  .card__role {
    font-size: var(--step--1);
    color: color-mix(in srgb, var(--cream) 78%, var(--deep));
  }
  .card__stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.5rem;
    width: 100%;
    padding-block: 0.75rem;
    border-block: 1px solid color-mix(in srgb, var(--cream) 18%, transparent);
  }
  .card__stats li {
    display: grid;
    gap: 0.1rem;
  }
  .card__stats b {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--step-2);
    color: var(--kiwi);
  }
  .card__stats span {
    font-size: 0.75rem;
    line-height: 1.2;
    color: color-mix(in srgb, var(--cream) 78%, var(--deep));
  }
  blockquote {
    margin: 0;
    font-style: italic;
    line-height: 1.35;
    text-wrap: balance;
  }
  .facets {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(0.9rem, 2vw, 1.5rem);
  }
  .facet {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 0.75rem;
    padding: clamp(1.1rem, 2vw, 1.5rem) 1rem;
    background: var(--surface);
    border-radius: var(--radius-l);
  }
  .facet .disc {
    width: 4rem;
    height: 4rem;
  }
  .facet h3 {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--step-2);
    line-height: 1.15;
    color: var(--title);
  }
  .takeaway {
    margin-top: clamp(1.5rem, 4vh, 2.5rem);
    display: flex;
    gap: 0.75rem;
    align-items: baseline;
    max-width: 64ch;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--step-2);
    line-height: 1.25;
    color: var(--fg);
    text-wrap: pretty;
  }
  .takeaway::before {
    content: '';
    flex: none;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--kiwi);
    box-shadow: var(--glow);
    transform: translateY(-2px);
  }
  @media (min-width: 768px) and (max-height: 820px) {
    .card {
      padding: 1rem 1.25rem;
      gap: 0.5rem;
    }
    .takeaway {
      margin-top: 1.25rem;
    }
  }
  @media (max-width: 900px) {
    .layout {
      grid-template-columns: 1fr;
    }
    .facets {
      grid-template-columns: 1fr;
    }
  }
</style>
