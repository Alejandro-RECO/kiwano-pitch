---
import { Image } from 'astro:assets';
import Slide from '../Slide.astro';
import logo from '../../assets/kiwano-logo.png';
import { site } from '../../data/deck';
---

<Slide id="inicio" bare>
  <div class="cover">
    <h1 class="cover__logo">
      <Image
        src={logo}
        alt={`${site.name}, ${site.tagline}`}
        widths={[480, 800, 1200]}
        sizes="(max-width: 767px) 88vw, 720px"
        loading="eager"
        fetchpriority="high"
      />
    </h1>
    <p class="cover__claim">{site.claim}</p>
    <p class="cover__sub">Agentes de IA para PyMes.</p>
  </div>
</Slide>

<style>
  .cover {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 0.75rem;
    padding-block: clamp(1rem, 4vh, 2rem);
  }

  .cover__logo {
    width: min(88vw, 720px);
    margin-bottom: clamp(1rem, 4vh, 2.5rem);
    animation: power-on 1.6s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }

  .cover__logo img {
    width: 100%;
    height: auto;
  }

  .cover__claim {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--step-4);
    line-height: 1.1;
    color: var(--title);
    text-wrap: balance;
    max-width: 22ch;
  }

  .cover__sub {
    max-width: 48ch;
    font-size: var(--step-1);
    color: var(--muted);
    text-wrap: pretty;
  }


  @media (min-width: 768px) and (max-height: 820px) {
    .cover__logo {
      width: min(80vw, 560px);
      margin-bottom: 0.75rem;
    }
  }

  @keyframes power-on {
    from {
      opacity: 0;
      filter: brightness(0.35) saturate(0.2) drop-shadow(0 0 0 transparent);
      transform: translateY(6px);
    }
    55% {
      opacity: 1;
      filter: brightness(0.85) saturate(0.7) drop-shadow(0 0 6px transparent);
    }
    to {
      opacity: 1;
      filter: brightness(1) saturate(1);
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cover__logo {
      animation: none;
    }
  }

  @media print {
    .cover__logo {
      animation: none;
    }
  }
</style>
