---
import Slide from '../Slide.astro';

const quadrants = [
  {
    letter: 'F',
    title: 'Fortalezas',
    items: [
      'Motor expandible a cualquier industria',
      'Agentes entrenables con las reglas del cliente',
      'Precio accesible frente a la competencia enterprise',
    ],
  },
  {
    letter: 'D',
    title: 'Debilidades',
    items: ['Producto nuevo, sin trayectoria de mercado', 'Dependencia de la calidad de los datos del cliente'],
  },
  {
    letter: 'O',
    title: 'Oportunidades',
    items: [
      'PYMES latinoamericanas masivamente desatendidas',
      'Crecimiento acelerado del mercado de agentes de IA',
    ],
  },
  {
    letter: 'A',
    title: 'Amenazas',
    items: ['Competidores low-code avanzando rápido', 'Grandes jugadores bajando precios al segmento PYME'],
  },
];
---

<Slide id="dofa">
  <h2 class="slide__title">Análisis DOFA</h2>
  <p class="slide__lead">Dónde estamos parados antes de salir al mercado.</p>

  <div class="slide__body matrix">
    <span class="axis axis--col" style="grid-column: 2" aria-hidden="true">Favorable</span>
    <span class="axis axis--col" style="grid-column: 3" aria-hidden="true">Desfavorable</span>
    <span class="axis axis--row" style="grid-row: 2" aria-hidden="true">Interno</span>
    <span class="axis axis--row" style="grid-row: 3" aria-hidden="true">Externo</span>
    {
      quadrants.map((q) => (
        <section class="quad" aria-labelledby={`q-${q.letter}`}>
          <header class="quad__head">
            <span class="quad__letter" aria-hidden="true">
              {q.letter}
            </span>
            <h3 id={`q-${q.letter}`}>{q.title}</h3>
          </header>
          <ul>
            {q.items.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</Slide>

<style>
  .matrix {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) minmax(0, 1fr);
    grid-template-rows: auto 1fr 1fr;
    gap: 0.75rem 1rem;
    align-items: stretch;
  }

  .axis {
    font-size: var(--step--1);
    color: var(--muted);
    font-weight: 600;
  }

  .axis--col {
    grid-row: 1;
    text-align: center;
  }

  .axis--row {
    grid-column: 1;
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    text-align: center;
    align-self: center;
  }

  /* Filas: interno / externo. Columnas: favorable / desfavorable. */
  .quad:nth-of-type(1) {
    grid-area: 2 / 2;
  }
  .quad:nth-of-type(2) {
    grid-area: 2 / 3;
  }
  .quad:nth-of-type(3) {
    grid-area: 3 / 2;
  }
  .quad:nth-of-type(4) {
    grid-area: 3 / 3;
  }

  .quad {
    border: 1.5px solid var(--deep);
    border-radius: var(--radius-m);
    padding: 1.1rem 1.25rem 1.25rem;
    background: color-mix(in srgb, var(--cream) 96%, var(--deep));
    display: grid;
    gap: 0.75rem;
    align-content: start;
  }

  .quad__head {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .quad__letter {
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 0.6rem;
    display: grid;
    place-items: center;
    background: var(--deep);
    color: var(--cream);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--step-2);
  }

  .quad h3 {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--step-2);
    line-height: 1.1;
    color: var(--title);
  }

  .quad ul {
    display: grid;
    gap: 0.45rem;
  }

  .quad li {
    display: flex;
    gap: 0.6rem;
    align-items: baseline;
    text-wrap: pretty;
  }

  .quad li::before {
    content: '';
    flex: none;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--deep);
    transform: translateY(-2px);
  }

  @media (max-width: 767px) {
    .matrix {
      grid-template-columns: 1fr;
      grid-template-rows: none;
    }
    .axis {
      display: none;
    }
    .quad:nth-of-type(n) {
      grid-area: auto;
    }
  }
</style>
