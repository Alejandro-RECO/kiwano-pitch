---
import Slide from '../Slide.astro';
import Icon from '../Icon.astro';
import { costos, cop } from '../../data/costos';

const agente = costos.precios.find((p) => p.plan === 'Agente')!.precio;
const auxiliar = costos.referencia.auxiliar;
const ahorro = Math.round((1 - agente / auxiliar) * 100);

// El valor en dos comparaciones, cada una con su escala: costo al mes y horas a la semana.
const comparaciones = [
  {
    titulo: 'Costo al mes',
    max: auxiliar,
    filas: [
      { quien: 'Auxiliar', valor: auxiliar, texto: cop(auxiliar) },
      { quien: 'Agente Kiwano', valor: agente, texto: cop(agente), hot: true },
    ],
    nota: `−${ahorro} %`,
  },
  {
    titulo: 'Horas de trabajo a la semana',
    max: 168,
    filas: [
      { quien: 'Auxiliar', valor: 48, texto: '48 h' },
      { quien: 'Agente Kiwano', valor: 168, texto: '168 h', hot: true },
    ],
    nota: '3,5×',
  },
];

// Lo diferente: qué recibe la PyMe que no le da ninguna otra opción.
const diferencias = [
  { icon: 'sliders', titulo: 'A tu medida', texto: 'Aprende las reglas de tu empresa, no una plantilla.' },
  { icon: 'rocket', titulo: 'Listo en 6 semanas', texto: 'Un MVP medible antes de la mensualidad.' },
  { icon: 'shield-check', titulo: 'Sin equipo técnico', texto: 'Lo operamos nosotros, con supervisión humana.' },
] as const;
---

<Slide id="valor">
  <h2 class="slide__title">La mitad del costo, todo el día</h2>
  <p class="slide__lead">Un agente de IA a la medida de tu PyMe, por casi la mitad de lo que cuesta un auxiliar.</p>

  <div class="slide__body split">
    <section class="compare" aria-label="El valor en cifras">
      {
        comparaciones.map((c) => (
          <figure class="bars">
            <figcaption>
              {c.titulo} <b class="bars__note">{c.nota}</b>
            </figcaption>
            <ul>
              {c.filas.map((f) => (
                <li class:list={{ hot: 'hot' in f }}>
                  <span class="bars__who">{f.quien}</span>
                  <span class="bars__track">
                    <span class="bars__fill" style={`--w: ${(f.valor / c.max) * 100}%`} />
                  </span>
                  <span class="bars__val">{f.texto}</span>
                </li>
              ))}
            </ul>
          </figure>
        ))
      }
    </section>

    <ul class="diffs" aria-label="Lo diferente">
      {
        diferencias.map((d) => (
          <li class="diff">
            <span class="disc">
              <Icon name={d.icon} />
            </span>
            <div>
              <h3>{d.titulo}</h3>
              <p>{d.texto}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</Slide>

<style>
  .slide__lead {
    max-width: 52ch;
  }
  .split {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: clamp(1.5rem, 4vw, 3.5rem);
    align-items: center;
  }
  .compare {
    display: grid;
    gap: clamp(1.25rem, 3.5vh, 2rem);
    padding: clamp(1.25rem, 2.5vw, 2rem);
    background: var(--surface);
    border-radius: var(--radius-l);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--kiwi) 25%, transparent);
  }
  .bars {
    display: grid;
    gap: 0.6rem;
  }
  .bars figcaption {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    font-weight: 700;
    color: var(--muted);
  }
  .bars__note {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--step-4);
    line-height: 1;
    color: var(--kiwi);
  }
  .bars ul {
    display: grid;
    gap: 0.5rem;
  }
  .bars li {
    display: grid;
    grid-template-columns: 7.5rem minmax(0, 1fr) 6.5rem;
    gap: 0.75rem;
    align-items: center;
  }
  .bars__who {
    font-size: var(--step--1);
    font-weight: 600;
  }
  .bars__track {
    height: 1.6rem;
  }
  .bars__fill {
    display: block;
    height: 100%;
    width: var(--w);
    border-radius: 0 4px 4px 0;
    background: var(--brown);
  }
  .bars li.hot .bars__fill {
    background: var(--kiwi);
  }
  .bars__val {
    font-family: var(--font-display);
    font-weight: 600;
    text-align: right;
    font-variant-numeric: tabular-nums;
  }
  .bars li.hot .bars__val {
    color: var(--kiwi);
  }
  .diffs {
    display: grid;
    gap: clamp(1rem, 3vh, 1.6rem);
  }
  .diff {
    display: flex;
    gap: 1rem;
    align-items: center;
  }
  .diff h3 {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--step-2);
    line-height: 1.15;
    color: var(--kiwi);
  }
  .diff p {
    color: var(--muted);
    text-wrap: pretty;
  }
  @media (max-width: 900px) {
    .split {
      grid-template-columns: 1fr;
    }
  }
</style>
