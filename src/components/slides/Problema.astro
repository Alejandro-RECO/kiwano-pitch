---
import Slide from '../Slide.astro';
import Icon from '../Icon.astro';
import { costos } from '../../data/costos';

const problems = [
  {
    icon: 'clock',
    title: 'Todo a mano',
  },
  {
    icon: 'users',
    title: 'Decisiones lentas',
  },
  {
    icon: 'trending-up',
    title: 'Más errores y costos',
  },
] as const;

/*
 * Gráfico: costo mensual de procesar pedidos a mano frente a Kiwano.
 * Supuesto del equipo: un auxiliar procesa unos 1.000 pedidos al mes.
 */
const auxiliar = costos.referencia.auxiliar / 1e6;
const planAgente = costos.precios.find((p) => p.plan === 'Agente')!.precio / 1e6;
const planOperacion = costos.precios.find((p) => p.plan === 'Operación')!.precio / 1e6;

const W = 560;
const H = 330;
const L = 52;
const R = 540;
const T = 24;
const B = 286;
const X_MAX = 4000;
const Y_MAX = 12;
const x = (v: number) => L + (v / X_MAX) * (R - L);
const y = (m: number) => B - (m / Y_MAX) * (B - T);

// Escalera: un auxiliar más por cada 1.000 pedidos.
const manual: [number, number][] = [];
for (let k = 0; k < 4; k++) {
  manual.push([k * 1000, (k + 1) * auxiliar], [(k + 1) * 1000, (k + 1) * auxiliar]);
}
const kiwano: [number, number][] = [
  [0, planAgente],
  [2000, planAgente],
  [2000, planOperacion],
  [4000, planOperacion],
];
const pts = (s: [number, number][]) => s.map(([a, b]) => `${x(a)},${y(b)}`).join(' ');
const ahorro = `${pts(manual)} ${pts([...kiwano].reverse())}`;
const ticksY = [0, 4, 8, 12];
const ticksX = [0, 1000, 2000, 3000, 4000];
const fmtM = (m: number) => `$${m.toLocaleString('es-CO', { maximumFractionDigits: 1 })} M`;
---

<Slide id="problema">
  <h2 class="slide__title">El problema</h2>
  <p class="slide__lead">Las pymes pierden tiempo y dinero.</p>

  <div class="slide__body split">
    <ul class="problems">
      {
        problems.map((p) => (
          <li class="problem">
            <span class="disc">
              <Icon name={p.icon} />
            </span>
            <h3>{p.title}</h3>
          </li>
        ))
      }
    </ul>

    <figure class="chart">
      <figcaption class="chart__title">Hoy, crecer significa contratar</figcaption>
      <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-labelledby="prob-desc">
        <desc id="prob-desc">
          Costo mensual según los pedidos procesados al mes. A mano, el costo sube un auxiliar por cada 1.000 pedidos,
          hasta {fmtM(4 * auxiliar)}. Con Kiwano se mantiene entre {fmtM(planAgente)} y {fmtM(planOperacion)}.
        </desc>
        {
          ticksY.map((t) => (
            <g class="grid">
              <line x1={L} x2={R} y1={y(t)} y2={y(t)} />
              <text x={L - 8} y={y(t) + 4} text-anchor="end">
                {t === 0 ? '0' : `$${t} M`}
              </text>
            </g>
          ))
        }
        {
          ticksX.map((t) => (
            <text class="tick" x={x(t)} y={B + 20} text-anchor="middle">
              {t.toLocaleString('es-CO')}
            </text>
          ))
        }
        <text class="tick" x={R} y={B + 38} text-anchor="end">pedidos al mes →</text>

        <polygon class="gap" points={ahorro} />
        <text class="gap__label" x={x(2900)} y={y(5.6)} text-anchor="middle">Ahorro</text>

        <polyline class="line line--manual" points={pts(manual)} />
        <polyline class="line line--kiwano" points={pts(kiwano)} />
        {
          [1, 2, 3, 4].map((k) => (
            <g class="step">
              <circle cx={x(k * 1000 - 500)} cy={y(k * auxiliar)} r="11" />
              <text x={x(k * 1000 - 500)} y={y(k * auxiliar) + 4} text-anchor="middle">
                {k}
              </text>
            </g>
          ))
        }

        <text class="label label--manual" x={R} y={y(4 * auxiliar) - 18} text-anchor="end">
          A mano: {fmtM(4 * auxiliar)}
        </text>
        <text class="label label--kiwano" x={R} y={y(planOperacion) - 12} text-anchor="end">
          Con Kiwano: {fmtM(planOperacion)}
        </text>
      </svg>
      <p class="chart__note">● = auxiliares contratados (≈ 1.000 pedidos al mes cada uno)</p>
    </figure>
  </div>
</Slide>

<style>
  .split {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(1.5rem, 4vw, 3.5rem);
    align-items: center;
  }
  .problems {
    display: grid;
    gap: 1.5rem;
  }
  .problem {
    display: flex;
    gap: 1rem;
    align-items: center;
  }
  .problem h3 {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--step-2);
    line-height: 1.1;
    color: var(--title);
  }
  .chart {
    display: grid;
    gap: 0.5rem;
    padding: clamp(1rem, 2vw, 1.5rem);
    background: var(--surface);
    border-radius: var(--radius-l);
  }
  .chart__title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--step-2);
    color: var(--deep);
  }
  .chart svg {
    width: 100%;
    height: auto;
    max-height: 52vh;
    font-family: var(--font-body);
    overflow: visible;
  }
  .grid line {
    stroke: var(--line);
    stroke-width: 1;
  }
  .grid text,
  .tick {
    font-size: 12px;
    fill: var(--muted);
  }
  .gap {
    fill: color-mix(in srgb, var(--kiwi) 35%, transparent);
  }
  .gap__label {
    font-family: var(--font-display);
    font-size: 20px;
    font-weight: 600;
    fill: var(--deep);
  }
  .line {
    fill: none;
    stroke-width: 3;
    stroke-linejoin: round;
  }
  .line--manual {
    stroke: var(--brown);
  }
  .line--kiwano {
    stroke: var(--deep);
    stroke-width: 4;
  }
  .step circle {
    fill: var(--brown);
    stroke: var(--surface);
    stroke-width: 2;
  }
  .step text {
    font-size: 12px;
    font-weight: 700;
    fill: var(--cream);
  }
  .label {
    font-size: 15px;
    font-weight: 800;
    fill: var(--fg);
    paint-order: stroke;
    stroke: var(--surface);
    stroke-width: 4px;
  }
  .chart__note {
    font-size: 0.78rem;
    color: var(--muted);
  }
  @media (max-width: 900px) {
    .split {
      grid-template-columns: 1fr;
    }
  }
</style>
