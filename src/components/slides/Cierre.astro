---
import { Image } from 'astro:assets';
import Slide from '../Slide.astro';
import Icon from '../Icon.astro';
import logo from '../../assets/kiwano-logo.png';
import { site } from '../../data/deck';

// Hoja de ruta: el mismo motor, industria por industria.
const industrias = [
  { icon: 'truck', nombre: 'Logística', hoy: true },
  { icon: 'package', nombre: 'Comercio' },
  { icon: 'wallet', nombre: 'Finanzas' },
  { icon: 'headset', nombre: 'Atención' },
] as const;

---

<Slide id="cierre" bare>
  <div class="end">
    <Image
      class="end__logo"
      src={logo}
      alt={`${site.name}, ${site.tagline}`}
      widths={[360, 600, 900]}
      sizes="(max-width: 767px) 70vw, 420px"
      loading="lazy"
    />
    <h2 class="end__claim">{site.claim}</h2>
    <ol class="road" aria-label="Hoy logística; mañana, cualquier industria">
      {
        industrias.map((i) => (
          <li class:list={['road__stop', { 'road__stop--now': 'hoy' in i }]}>
            <span class="road__icon">
              <Icon name={i.icon} />
            </span>
            <span>{i.nombre}</span>
            <small>{'hoy' in i ? 'Hoy' : 'Mañana'}</small>
          </li>
        ))
      }
    </ol>

    <div class="end__actions">
      <button class="btn btn--ghost" type="button" data-action="print">
        <Icon name="printer" size={16} />
        Guardar como PDF
      </button>
    </div>

    <p class="end__thanks">Gracias. ¿Preguntas?</p>
  </div>
</Slide>

<style>
  .end {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 0.9rem;
    padding-block: clamp(1rem, 4vh, 2rem);
  }

  .end__logo {
    width: min(70vw, 420px);
    height: auto;
    margin-bottom: clamp(0.75rem, 3vh, 1.75rem);
  }

  .end__claim {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--step-5);
    line-height: 1.05;
    color: var(--title);
    text-wrap: balance;
    max-width: 20ch;
  }

  .road {
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 7.5rem));
    gap: clamp(0.75rem, 3vw, 2rem);
    margin-top: 0.5rem;
  }
  /* Línea que une las industrias: de hoy hacia mañana. */
  .road::before {
    content: '';
    position: absolute;
    top: 1.75rem;
    left: 12%;
    right: 12%;
    height: 2px;
    background: linear-gradient(90deg, var(--kiwi), var(--ink-3));
  }
  .road__stop {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 0.3rem;
    font-family: var(--font-display);
    font-weight: 500;
    color: var(--muted);
  }
  .road__icon {
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--ink-2);
    border: 2px solid var(--ink-3);
    color: var(--muted);
  }
  .road__stop small {
    font-family: var(--font-body);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .road__stop--now {
    color: var(--cream);
  }
  .road__stop--now .road__icon {
    background: var(--deep);
    border-color: var(--kiwi);
    color: var(--kiwi);
  }
  .road__stop--now small {
    color: var(--kiwi);
  }

  .end__actions {
    margin-top: clamp(1rem, 3vh, 1.75rem);
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
  }

  .btn {
    appearance: none;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.85rem 1.5rem;
    border-radius: 999px;
    font: inherit;
    font-weight: 700;
    text-decoration: none;
    cursor: pointer;
    border: 2px solid transparent;
  }


  .btn--ghost {
    background: transparent;
    color: var(--fg);
    border-color: var(--brown);
  }

  .btn--ghost:hover {
    background: var(--brown);
    color: var(--cream);
  }

  .end__thanks {
    margin-top: clamp(1rem, 4vh, 2rem);
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--step-3);
    color: var(--fg);
  }

  @media print {
    .end__actions {
      display: none;
    }
  }
</style>
